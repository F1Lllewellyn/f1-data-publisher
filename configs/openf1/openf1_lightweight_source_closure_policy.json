{
  "policy_name": "openf1_lightweight_source_closure",
  "created": "2026-06-10",
  "season": 2026,
  "purpose": "Capture lightweight OpenF1 source lanes and zero-lane diagnostics in GitHub so manual Colab catch-up is not required.",
  "source_hierarchy": [
    "existing GitHub latest artifact",
    "existing GitHub history path",
    "existing GitHub release/archive artifact",
    "local retained source artifacts",
    "targeted OpenF1 lightweight endpoint refresh"
  ],
  "default_year": 2026,
  "completed_session_only": true,
  "exclude_heavy_endpoints_by_default": [
    "car_data",
    "location"
  ],
  "required_lightweight_lanes": [
    "weather",
    "race_control",
    "intervals",
    "position",
    "stints",
    "pit",
    "starting_grid",
    "drivers"
  ],
  "opportunistic_lanes": [
    "team_radio"
  ],
  "provenance_shadow": {
    "status": "manual_non_default_integration_capability_only",
    "workflow_dispatch_input": "provenance_shadow_session_key",
    "default": "",
    "endpoint_workflow_dispatch_input": "provenance_shadow_endpoint",
    "allowed_ref": "refs/heads/main",
    "endpoint": "weather",
    "allowed_endpoints": [
      "weather",
      "drivers",
      "starting_grid"
    ],
    "default_endpoint": "weather",
    "selected_session_count": 1,
    "historical_window_delay_seconds": 1800,
    "api_base": "https://api.openf1.org/v1",
    "runtime_dir": "_runtime/dr002_pre2b7k4r2_openf1_historical_rest_shadow",
    "scheduled_enabled": false,
    "commit_or_push_enabled": false,
    "writes_latest_or_history": false,
    "requires_credentials_or_paid_live_access": false,
    "creates_verified_receipt_bindings": false,
    "drivers_mode": {
      "raw_filename": "drivers.response.json",
      "request_parameters": [
        "session_key"
      ],
      "requires_k4r6_validation": true,
      "persists_derived_csv": false,
      "derived_csv_is_source_evidence": false,
      "creates_scientific_or_normalization_receipt": false,
      "openf1_official_f1_roster_authority": false,
      "historical_availability_before_first_observation_proven": false
    },
    "starting_grid_mode": {
      "manual_only": true,
      "requires_explicit_historical_qualifying_source_session_key": true,
      "session_discovery_raw_filename": "sessions.response.json",
      "raw_filename": "starting_grid.response.json",
      "request_parameters": [
        "session_key"
      ],
      "maximum_response_bytes": 8388608,
      "requires_exact_final_url": true,
      "redirects_allowed": false,
      "requires_json_content_type_when_exposed": true,
      "requires_k4r1_validation": true,
      "requires_k4r14_validation": true,
      "required_source_session_name": "Qualifying",
      "required_source_session_type": "Qualifying",
      "required_target_session_name": "Race",
      "required_target_session_type": "Race",
      "source_to_race_link_evidence_type": "OPENF1_PROVIDER_DISCOVERY_CLAIM",
      "source_receipt_scope": "QUALIFYING_SOURCE_SESSION_ONLY",
      "producer_input_csv_is_target_race_scoped": false,
      "cross_session_join_authorized": false,
      "persists_derived_csv": false,
      "derived_csv_is_source_evidence": false,
      "official_fia_grid_authenticated": false,
      "official_final_grid_verified": false,
      "historical_pre_race_availability_proven": false,
      "stable_engine_execution_proven": false,
      "production_forecast_generated": false
    },
    "dr002_activated": false,
    "promotion_allowed": false
  },
  "endpoint_strategies": {
    "weather": [
      "session_key"
    ],
    "race_control": [
      "session_key"
    ],
    "intervals": [
      "session_key"
    ],
    "position": [
      "session_key",
      "meeting_key_fallback"
    ],
    "stints": [
      "session_key"
    ],
    "pit": [
      "race_or_sprint_session_key_only"
    ],
    "starting_grid": [
      "session_key"
    ],
    "drivers": [
      "session_key",
      "observed_driver_number_session_key"
    ],
    "team_radio": [
      "session_key_opportunistic"
    ]
  },
  "zero_lane_policy": {
    "hard_required_zero_rows": "retry_with_endpoint_specific_strategy_then_mark_needs_review",
    "opportunistic_zero_rows": "mark_source_limited_not_failure",
    "future_session_zero_rows": "mark_gated_not_missing"
  },
  "outputs": {
    "latest_dir": "latest/openf1_lightweight_source_closure",
    "history_dir": "history/openf1_lightweight_source_closure",
    "zip_name": "openf1_lightweight_source_closure.zip"
  },
  "timestamp_policy": "Use timezone-aware dt.datetime.now(dt.UTC) throughout retrieval scripts.",
  "no_drs_2026_assumption": true
}
