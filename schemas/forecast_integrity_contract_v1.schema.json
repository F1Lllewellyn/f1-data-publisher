    "forecast_generation_utc": {
      "type": "string",
      "minLength": 1,
      "format": "date-time",
      "pattern": "Z$"
    },
    "forecast_deadline_utc": {
      "type": "string",
      "minLength": 1,
      "format": "date-time",
      "pattern": "Z$"
    },
    "forecast_lock_utc": {
      "type": "string",
      "minLength": 1,
      "format": "date-time",
      "pattern": "Z$"
    },
    "outcome_availability_boundary_utc": {
      "type": "string",
      "minLength": 1,
      "format": "date-time",
      "pattern": "Z$"
    },
    "outcome_boundary_evidence_ref": {
      "type": "string",
      "minLength": 1
    },
    "lock_receipt_ref": {
      "type": "string",
      "minLength": 1
