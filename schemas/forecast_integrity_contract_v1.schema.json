      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "meeting_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "allowed_session_ids": {
      "type": [
        "array",
        "null"
      ],
